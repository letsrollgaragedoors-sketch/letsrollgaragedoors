{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/garage-door-wont-close-austin.html",
      "destination": "/garage-door-wont-open-close-austin.html",
      "permanent": true
    },
    {
      "source": "/garage-door-wont-open-austin.html",
      "destination": "/garage-door-wont-open-close-austin.html",
      "permanent": true
    },
    {
      "source": "/garage-door-tune-up-maintenance-austin.html",
      "destination": "/garage-door-tune-up-austin.html",
      "permanent": true
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/blog-fixes-patch.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/patch_phase3b_links.py",
      "destination": "/",
      "permanent": false
    }
  ]
}
